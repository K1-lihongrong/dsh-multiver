# 依赖
node_modules/

# 开发期 pnpm store（由 pnpm-workspace.yaml 的 storeDir 指定在项目内）
.pnpm-store/

# 构建产物
dist/
src-tauri/target/

# 图标生成中间文件
icon-1024.png

# 日志
*.log

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# 系统
.DS_Store
Thumbs.db

# 本地数据（如果误建在源码目录）
# 注意：必须锚定到仓库根（前导 /），否则会误伤 src-tauri/src/versions/ 等源码目录
/config.json
/versions/
/home/
/store/
/cache/
/state/

# AI 助手项目说明（本地辅助文件）
.cuckoo/

# 临时脚本 / 截图（开发过程产物，不进仓库）
.ci-poll*.ps1
.ci-poll*.log
.wsl-*.sh
.wsl-*.ps1
docs/screenshots/theme/

# Playwright E2E 产物
test-results/
playwright-report/
blob-report/

# 插件包发布产物（pnpm pack 出的 tarball，随 Release 分发，不进仓库）
dsh-plugin/*.tgz

# 打包产物：exe 复制到仓库根供实机测试，不进仓库
/dsh-multiver.exe

# 构建日志（后台构建时重定向输出用）
.build-*.log
.build-*.log.err
