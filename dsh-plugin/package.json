{
  "name": "dsh-multiver-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "dsh-multiver 双向桥：在 dsh 内查看/切换版本",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K1-lihongrong/dsh-multiver.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/K1-lihongrong/dsh-multiver/tree/main/dsh-plugin",
  "bugs": {
    "url": "https://github.com/K1-lihongrong/dsh-multiver/issues"
  },
  "dshMultiver": {
    "verifiedDshVersions": [
      "0.2.1-rc.2",
      "0.2.1-rc.3"
    ]
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "install.ps1",
    "uninstall.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
