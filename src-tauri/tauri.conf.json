{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-multiver",
  "version": "0.1.7",
  "identifier": "io.github.K1-lihongrong.dsh-multiver",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DSH 版本管理器",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
